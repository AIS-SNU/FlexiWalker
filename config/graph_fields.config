# Graph Field Definitions
# This file defines what additional fields are needed by walkers.
#
# IMPORTANT: Changing this file requires running the pipeline and recompiling!
#
# Format:
#   field_name[Walker1,Walker2,...] = source_type:data_type:size_type:init_value
#
# source_type:
#   - file: load from binary file (path specified in graph-specific config)
#   - init: initialize all elements with a constant value
#
# size_type:
#   - edge: array size is edge_num (edge-based field)
#   - node: array size is vtx_num (node-based field)
#
# Examples:
#   edge_label[Metapath,Metapath_weighted] = file:int:edge
#   custom_weights[MyWalker] = init:weight_t:edge:1.0

# Edge labels for heterogeneous graph walkers (Metapath)
edge_label[Metapath,Metapath_weighted] = file:int:edge
