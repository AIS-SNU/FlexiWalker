# Graph-specific file paths for wiki-Vote dataset
# This file can be modified without recompilation.
#
# Format: field_name = /path/to/file
#
# Standard CSR fields (required):
#   xadj, adjncy, adjwgt
#
# Additional fields (only needed if defined in graph_fields.config):
#   edge_label, etc.

# Required: Standard graph structure
xadj = ../../data/wiki-Vote/wiki-Vote_xadj.bin
adjncy = ../../data/wiki-Vote/wiki-Vote_edge.bin
adjwgt = ../../data/wiki-Vote/wiki-Vote_weight.bin

# Optional: Additional walker-specific fields
# Uncomment if needed for your walker
edge_label = ../../data/wiki-Vote/wiki-Vote_mp_label.bin
