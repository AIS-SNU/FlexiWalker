# Test-specific graph config for the e2e smoke-test suite.
# Points at the wiki-Vote binaries in the repo's own data/ directory
# (not the shared /data mount) so the tests are self-contained.
#
# Paths are resolved from build/, which is where flowwalker executes.

xadj = ../data/wiki-Vote_xadj.bin
adjncy = ../data/wiki-Vote_edge.bin
adjwgt = ../data/wiki-Vote_weight.bin

# edge_label is referenced by the default wiki-Vote.config but the
# repo ships wiki-Vote_label.bin (not wiki-Vote_mp_label.bin) — use the
# shipped file so Metapath smoke tests can read it.
edge_label = ../data/wiki-Vote_label.bin
