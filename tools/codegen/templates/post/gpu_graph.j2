#ifndef LLVM_ANALYSIS

template <typename T>
__global__ void preprocess_kernel(
    const edge_t* __restrict__ xadj,       // size: vtx_num + 1
    const T* __restrict__ input,           // input weights
    T* __restrict__ output_max,            // output max per node (nullptr to skip)
    T* __restrict__ output_min,            // output min per node (nullptr to skip)
    T* __restrict__ output_sum,            // output sum per node (nullptr to skip)
    int vtx_num
) {
    int warpSize = 32;
    int global_thread_id = blockIdx.x * blockDim.x + threadIdx.x;
    int warp_id = global_thread_id / warpSize;
    int lane_id = threadIdx.x % warpSize;

    int total_warps = (gridDim.x * blockDim.x) / warpSize;

    for (int node_idx = warp_id; node_idx < vtx_num; node_idx += total_warps) {
      edge_t start = xadj[node_idx];
      edge_t end = xadj[node_idx + 1];

      T max_val = -1;
      T min_val = std::numeric_limits<T>::max();
      T sum_val = 0;

      for (edge_t e = start + lane_id; e < end; e += warpSize) {
        max_val = max(max_val, input[e]);
        min_val = min(min_val, input[e]);
        sum_val += input[e];
      }

      // Warp-level reduction across lanes
      max_val = warpReduceMax(max_val);
      min_val = warpReduceMin(min_val);
      sum_val = warpReduce(sum_val);

      if (lane_id == 0) {
        if (output_max) output_max[node_idx] = max_val;
        if (output_min) output_min[node_idx] = min_val;
        if (output_sum) output_sum[node_idx] = sum_val;
      }
    }
}

#endif

// Extension for struct {{ struct_name }}
class {{ struct_name }} : public {{ struct_name }}_base {
  public:
{%- for type, name, _ in extra_fields %}
  {{ type }} {{ name }} = nullptr;
{%- endfor %}
{%- for field_name, field_info in additional_fields.items() %}
  {{ field_info.data_type }}* {{ field_name }} = nullptr;
{%- endfor %}

  public:
    ~{{ struct_name }}() {
{%- for type, name, _ in extra_fields %}
      if ({{ name }}) cudaFree({{ name }});
{%- endfor %}
{%- for field_name, field_info in additional_fields.items() %}
      if ({{ field_name }}) cudaFree({{ field_name }});
{%- endfor %}
    }
    {{ struct_name }}() : {{ struct_name }}_base() {}
    explicit {{ struct_name }}(graph* ginst) : {{ struct_name }}_base(ginst) {
      int blockSize = 256;
      int numBlocks = 512;
      #ifndef LLVM_ANALYSIS
      {%- for type, name, condition in extra_fields %}
        if (FLAGS_umgraph) {
          CUDA_RT_CALL(cudaMallocManaged(&{{ name }}, sizeof({{type | replace("*", "")}}) * vtx_num));
        } else {
          CUDA_RT_CALL(cudaMalloc(&{{ name }}, sizeof({{type | replace("*", "")}}) * vtx_num));
        }
      {%- endfor %}

      // Additional fields from graph_fields.config
{%- for field_name, field_info in additional_fields.items() %}
      // {{ field_name }} for {{ field_info.walkers | join(', ') }}
      if ({{ field_info.walkers | map('add_flags_prefix') | join(' || ') }}) {
{%- if field_info.source_type == 'file' %}
        // Copy from host graph
        if (ginst->{{ field_name }} != nullptr) {
          ll {{ field_name }}_sz = sizeof({{ field_info.data_type }}) * {% if field_info.size_type == 'node' %}vtx_num{% else %}edge_num{% endif %};
          if (FLAGS_umgraph) {
            CUDA_RT_CALL(cudaMallocManaged(&{{ field_name }}, {{ field_name }}_sz));
          } else {
            CUDA_RT_CALL(cudaMalloc(&{{ field_name }}, {{ field_name }}_sz));
          }
          CUDA_RT_CALL(cudaMemcpy({{ field_name }}, ginst->{{ field_name }}, {{ field_name }}_sz, cudaMemcpyHostToDevice));
        }
{%- elif field_info.source_type == 'init' %}
        // Initialize with constant value
        ll {{ field_name }}_sz = sizeof({{ field_info.data_type }}) * {% if field_info.size_type == 'node' %}vtx_num{% else %}edge_num{% endif %};
        if (FLAGS_umgraph) {
          CUDA_RT_CALL(cudaMallocManaged(&{{ field_name }}, {{ field_name }}_sz));
        } else {
          CUDA_RT_CALL(cudaMalloc(&{{ field_name }}, {{ field_name }}_sz));
        }
        CUDA_RT_CALL(cudaMemset({{ field_name }}, {{ field_info.init_value }}, {{ field_name }}_sz));
{%- endif %}
      }
{% endfor %}
{%- for field in edge_preprocess_fields %}
        if ({{ field.condition }}) {
          preprocess_kernel<{{ field.data_type }}><<<numBlocks, blockSize>>>(
            xadj,
            {{ field.base_name }},
            {% if 'max' in field.preprocess_ops %}{{ field.base_name }}_MAX{% else %}nullptr{% endif %},
            {% if 'min' in field.preprocess_ops %}{{ field.base_name }}_MIN{% else %}nullptr{% endif %},
            {% if 'sum' in field.preprocess_ops %}{{ field.base_name }}_SUM{% else %}nullptr{% endif %},
            vtx_num);
          CUDA_RT_CALL(cudaDeviceSynchronize());
        }
{%- endfor %}
      #endif
    }
};
